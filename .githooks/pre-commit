#!/usr/bin/env bash
# pre-commit 钩子：提交前跑语法检查 → 内置自检 → 六层桩测试（有 shellcheck 时再加静态分析）。
# 注：all.sh 内部第一层就是 --self-test，这里不再单独重复跑一遍。
#
# 启用（在仓库根目录执行一次）：
#   git config core.hooksPath .githooks
# 临时跳过（确有急事时）：
#   git commit --no-verify
#
# 设计意图：把"提交前必过"的门槛放在本地，而不是等合并后才发现。
# 只在 vps-init.sh / .selftest 有改动时才跑，无关提交不会被拖慢。
set -uo pipefail
cd "$(git rev-parse --show-toplevel 2>/dev/null || echo .)" || exit 1

changed="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
[[ -n $changed ]] || exit 0
if ! printf '%s\n' "$changed" | grep -qE '^(vps-init\.sh|\.selftest/)'; then
    exit 0
fi

echo "[pre-commit] 检测到 vps-init.sh / .selftest 改动，开始自检…"

if ! bash -n vps-init.sh; then
    echo "[pre-commit] ✗ vps-init.sh 语法错误，已拒绝提交"
    exit 1
fi

if command -v shellcheck >/dev/null 2>&1; then
    # 只看 error 级：warning/info 里混着大量风格建议，
    # 且本机是 Windows（目标平台是 Debian），平台偏差会造成噪声。
    if ! shellcheck -S error vps-init.sh; then
        echo "[pre-commit] ✗ shellcheck 发现 error 级问题，已拒绝提交"
        exit 1
    fi
else
    echo "[pre-commit] 提示：未安装 shellcheck，已跳过静态分析"
fi

if [[ -f .selftest/all.sh ]]; then
    # 一次跑、两次判：全量回归要十几分钟，此前第二遍只为了 grep「层跳过」标记，
    # 白白把提交门槛拖到 ~35 分钟。tee 留日志，rc 与 SKIP 标记都从同一份输出判。
    _pc_log="$(mktemp "${TMPDIR:-/tmp}/.vps-init.precommit.XXXXXX")"
    if ! bash .selftest/all.sh 2>&1 | tee "$_pc_log"; then
        echo "[pre-commit] ✗ 六层自检未通过，已拒绝提交"
        rm -f "$_pc_log"
        exit 1
    fi
    # all.sh 退出码 0 但整层跳过（缺 python 时 renders/crlf 记 SKIP）也视为未通过：
    # "没崩"不等于"断言真的跑过"，提交门槛不能被假绿绕过
    if grep -q '层跳过' "$_pc_log"; then
        echo "[pre-commit] ✗ 自检存在跳过的层（缺依赖），已拒绝提交"
        rm -f "$_pc_log"
        exit 1
    fi
    rm -f "$_pc_log"
else
    echo "[pre-commit] 提示：未找到 .selftest/all.sh，跳过桩测试"
fi

echo "[pre-commit] ✓ 自检通过"
